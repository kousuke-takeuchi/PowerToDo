{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PowerToDo",
  "version": "0.1.0",
  "identifier": "app.powertodo",
  "build": {
    "beforeDevCommand": "npm run build:tailnet && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:tailnet && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PowerToDo",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/powertodo-tailnet"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYyNUQxRjY0RUU5NUI1OTgKUldTWXRaWHVaQjlkOHFEMk9HdXprWnBndkt4cUl6VENzNHJwK21HU3NRYms1UjFHeno4Ky96Sk8K",
      "endpoints": [
        "https://github.com/kousuke-takeuchi/PowerToDo/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
