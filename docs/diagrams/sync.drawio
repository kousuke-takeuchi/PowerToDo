<mxfile host="drawio">
  <diagram id="sync" name="同期">
    <mxGraphModel dx="1000" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="860" pageHeight="420" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="mac" value="Mac / Windows / Linux&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;データフォルダ (正本)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="pc2" value="別の PC&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;データフォルダ (正本)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="160" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="ios" value="iPhone&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;ファイル App の「このiPhone内 → PowerToDo」&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="280" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="nas" value="Synology NAS&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;WebDAV、共有フォルダ powertodo&lt;br&gt;Tailscale 経由&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=12;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="560" y="60" width="240" height="100" as="geometry" />
        </mxCell>
        <mxCell id="or" value="どちらか 1 つ" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="620" y="172" width="120" height="24" as="geometry" />
        </mxCell>
        <mxCell id="drive" value="Google Drive&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;PowerToDo フォルダ&lt;/font&gt;" style="shape=cloud;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="560" y="210" width="240" height="110" as="geometry" />
        </mxCell>
        <mxCell id="what" value="同期するもの: *.xlsx、_comments/*.jsonl、_attachments/*&lt;br&gt;しないもの: archive/、ロックファイル、競合コピー" style="text;html=1;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="290" y="350" width="520" height="40" as="geometry" />
        </mxCell>
        <mxCell id="a" style="endArrow=classic;startArrow=classic;html=1;" edge="1" parent="1" source="mac" target="nas"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="b" style="endArrow=classic;startArrow=classic;html=1;" edge="1" parent="1" source="pc2" target="nas"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c" style="endArrow=classic;startArrow=classic;html=1;" edge="1" parent="1" source="ios" target="nas"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="d" style="endArrow=classic;startArrow=classic;html=1;dashed=1;" edge="1" parent="1" source="ios" target="drive"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f" style="endArrow=classic;startArrow=classic;html=1;dashed=1;" edge="1" parent="1" source="pc2" target="drive"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e" style="endArrow=classic;startArrow=classic;html=1;dashed=1;" edge="1" parent="1" source="mac" target="drive"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
